# Copy as a new site file, replace hostnames, validate, then import it into Caddy.
# Do not inherit another site's Permissions-Policy: camera must be allowed here.
GAME_DOMAIN {
    encode zstd gzip
    root * /srv/iamultraman/current
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        Cache-Control "no-cache"
    }
    handle_path /assets/* {
        root * /srv/iamultraman/assets
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "*"
        file_server
    }
    file_server
}

# Optional separate CDN origin. Omit this block when using the game hostname
# through a CDN; keep /assets/* cached and HTML/deployment.json uncached.
ASSETS_DOMAIN {
    encode zstd gzip
    root * /srv/iamultraman
    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "*"
        header X-Content-Type-Options nosniff
        file_server
    }
    respond 404
}
